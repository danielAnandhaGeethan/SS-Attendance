# Base path/URL the frontend uses for API calls (see src/api/client.ts).
#
# In dev, this can stay as "/api" - vite.config.ts proxies that path to the
# local FastAPI backend at http://127.0.0.1:8000, so no CORS setup is
# needed. For a deployed build, point this at the deployed backend's full
# URL instead (e.g. https://api.example.com) - that requires the backend
# to send CORS headers allowing this frontend's origin.
VITE_API_BASE_URL=/api
